---
layout: base.njk
title: Collection
---
{% from "icons.njk" import icon %}
{% set total = collections.machines.length %}
{% set documented = collections.machines | documentedCount %}
<div class="stack">

  {# A Stickies note, like the ones on a Mac OS 8.5 desktop #}
  <section class="window sticky" aria-labelledby="note-title">
    <div class="titlebar">
      <span class="closebox" aria-hidden="true"></span>
      <h2 id="note-title" class="visually-hidden">Read Me</h2>
    </div>
    <div class="winbody">
      <div class="note">
        <h1 class="note-title">{{ site.title }}</h1>
        <p class="note-text">{{ site.tagline }}</p>
      </div>
    </div>
  </section>

  <section class="window cascade finder"{% if documented >= total %} data-front{% endif %} aria-labelledby="finder-title">
    <div class="titlebar">
      <span class="closebox" aria-hidden="true"></span>
      <h2 id="finder-title">Collection</h2>
      <span class="zoombox" aria-hidden="true"></span>
    </div>
    <div class="winbody">
    <div class="infobar">
      <span>{{ total }} {% if total == 1 %}item{% else %}items{% endif %}</span>
      <span>{{ documented }} documented</span>
    </div>
    <ul class="icons" role="list">
      {% for m in collections.machines %}
      <li>
        <a class="icon-item" href="{{ m.url | url }}">
          {% set cover = m.data.photos[0] if m.data.photos and m.data.photos.length else null %}
          <span class="thumb">
            {% if cover %}
            <img src="{{ ('/assets/machines/' ~ m.fileSlug ~ '/' ~ (cover.poster if cover.video else cover.file)) | url }}" alt="" loading="lazy">
            {% elif m.data.still %}
            <img src="{{ ('/assets/machines/' ~ m.fileSlug ~ '/' ~ m.data.still) | url }}" alt="" loading="lazy">
            {% else %}
            {{ icon(m.data.glyph or "compact", 64) }}
            {% endif %}
          </span>
          <span class="name">{{ m.data.title }}</span>
          <span class="sub">{{ m.data.year }}{% if m.data.sample %}, sample{% endif %}</span>
        </a>
      </li>
      {% endfor %}
    </ul>
    </div>
  </section>

    {% if documented < total %}
  <section class="window cascade checklist" data-front aria-labelledby="checklist-title">
    <div class="titlebar">
      <span class="closebox" aria-hidden="true"></span>
      <h2 id="checklist-title">Checklist</h2>
      <span class="zoombox" aria-hidden="true"></span>
    </div>
    <div class="winbody">
    <div class="infobar">
      <span>{{ documented }} of {{ total }} documented</span>
      <span>Checked once a machine has a photo</span>
    </div>
    <ul class="checks" role="list">
      {% for m in collections.machines %}
      {% set done = m.data.photos and m.data.photos.length %}
      <li>
        <a class="check-row" href="{{ m.url | url }}">
          <span class="check{% if done %} is-done{% endif %}" aria-hidden="true"></span>
          <span>{{ m.data.title }}</span>
          <span class="visually-hidden">{% if done %}, documented{% else %}, not yet documented{% endif %}</span>
        </a>
      </li>
      {% endfor %}
    </ul>
    </div>
  </section>
  {% endif %}

  {# The Videos window is not on the page until it is opened from the Videos menu: the browser only builds it, and starts loading videos, then. Without JavaScript it is simply shown here. #}
  <template id="videos-template">{% include "videos-window.njk" %}</template>
  <noscript>{% include "videos-window.njk" %}</noscript>

</div>

<script src="{{ '/assets/js/strip.js' | url }}" defer></script>
