---
layout: base.njk
title: Collection
---
{% from "icons.njk" import icon %}
{% set total = collections.machines.length %}
{% set documented = collections.machines | documentedCount %}
<div class="stack">

  {# A Stickies note, like the ones on a Mac OS 8.5 desktop #}
  <section class="window sticky" aria-labelledby="note-title">
    <div class="titlebar">
      <span class="closebox" aria-hidden="true"></span>
      <h2 id="note-title" class="visually-hidden">Read Me</h2>
    </div>
    <div class="winbody">
      <div class="note">
        <h1 class="note-title">{{ site.title }}</h1>
        <p class="note-text">{{ site.tagline }}</p>
      </div>
    </div>
  </section>

  <section class="window finder" data-front aria-labelledby="finder-title">
    <div class="titlebar">
      {# Becomes a working close box on a desktop browser (see windows.js); a phone has no windows to close #}
      <span class="closebox" aria-hidden="true"></span>
      <h2 id="finder-title">Collection</h2>
      <span class="zoombox" aria-hidden="true"></span>
    </div>
    <div class="winbody">
    <div class="infobar">
      <span>{{ total }} {% if total == 1 %}item{% else %}items{% endif %}</span>
      <span>{{ documented }} documented</span>
    </div>
    <div class="vscroll" data-vscroll>
    <div class="vs-view" data-vs-view tabindex="0" role="region" aria-label="Collection, {{ total }} machines">
    <ul class="icons" role="list">
      {% for m in collections.machines %}
      <li>
        <a class="icon-item" href="{{ m.url | url }}">
          {% set cover = m.data.photos[0] if m.data.photos and m.data.photos.length else null %}
          <span class="thumb">
            {% if cover %}
            <img src="{{ ('/assets/machines/' ~ m.fileSlug ~ '/' ~ (cover.poster if cover.video else cover.file)) | url }}" alt="" loading="lazy">
            {% elif m.data.still %}
            <img src="{{ ('/assets/machines/' ~ m.fileSlug ~ '/' ~ m.data.still) | url }}" alt="" loading="lazy">
            {% else %}
            {{ icon(m.data.glyph or "compact", 64) }}
            {% endif %}
          </span>
          <span class="name">{{ m.data.title }}</span>
          <span class="sub">{{ m.data.year }}{% if m.data.sample %}, sample{% endif %}</span>
        </a>
      </li>
      {% endfor %}
    </ul>
    </div>
    <div class="vbar" data-vs-bar hidden>
      <button type="button" class="vbtn" data-dir="-1" aria-label="Scroll up" tabindex="-1">
        <svg viewBox="0 0 16 16" width="16" height="16" shape-rendering="crispEdges" aria-hidden="true" focusable="false"><polygon points="8,4 13,10 3,10" fill="currentColor"/></svg>
      </button>
      <div class="vtrack" data-vs-track><span class="vknob" data-vs-knob></span></div>
      <button type="button" class="vbtn" data-dir="1" aria-label="Scroll down" tabindex="-1">
        <svg viewBox="0 0 16 16" width="16" height="16" shape-rendering="crispEdges" aria-hidden="true" focusable="false"><polygon points="8,12 13,6 3,6" fill="currentColor"/></svg>
      </button>
      {# Size box: drag to resize the window (desktop browsers; see windows.js) #}
      <span class="growbox" data-growbox aria-hidden="true"></span>
    </div>
    </div>
    </div>
  </section>


  {# The About, Checklist and Videos windows are not on the page until they are opened from the menu bar or a desktop icon (on a desktop browser): the browser only builds them, and starts loading videos, then. On a phone, and without JavaScript, those links go to pages of their own. #}
  <template id="about-template">{% include "about-window.njk" %}</template>
  <template id="checklist-template">{% include "checklist-window.njk" %}</template>
  <template id="videos-template">{% include "videos-window.njk" %}</template>
  {# One movie window per video, each opened from its own item in the Videos menu #}
  {% for v in montages %}{% set n = loop.index %}
  <template id="movie-template-{{ n }}" data-movie-template>{% include "movie-window.njk" %}</template>
  {% endfor %}
  <template id="note-template">{% include "note-window.njk" %}</template>

</div>

<script src="{{ '/assets/js/strip.js' | url }}?v={{ build }}" defer></script>
<script src="{{ '/assets/js/vscroll.js' | url }}?v={{ build }}" defer></script>
<script src="{{ '/assets/js/note.js' | url }}?v={{ build }}" defer></script>
