---
layout: base.njk
title: Collection
---
{% from "icons.njk" import icon %}
{% set total = collections.machines.length %}
{% set documented = collections.machines | documentedCount %}
<div class="stack">

  {# A Stickies note, like the ones on a Mac OS 8.5 desktop #}
  <section class="window sticky" aria-labelledby="note-title">
    <div class="titlebar">
      <span class="closebox" aria-hidden="true"></span>
      <h2 id="note-title" class="visually-hidden">Read Me</h2>
    </div>
    <div class="winbody">
      <div class="note">
        <h1 class="note-title">{{ site.title }}</h1>
        <p class="note-text">{{ site.tagline }}</p>
      </div>
    </div>
  </section>

  <section class="window cascade finder"{% if documented >= total %} data-front{% endif %} aria-labelledby="finder-title">
    <div class="titlebar">
      <span class="closebox" aria-hidden="true"></span>
      <h2 id="finder-title">Collection</h2>
      <span class="zoombox" aria-hidden="true"></span>
    </div>
    <div class="winbody">
    <div class="infobar">
      <span>{{ total }} {% if total == 1 %}item{% else %}items{% endif %}</span>
      <span>{{ documented }} documented</span>
    </div>
    <ul class="icons" role="list">
      {% for m in collections.machines %}
      <li>
        <a class="icon-item" href="{{ m.url | url }}">
          {% set cover = m.data.photos[0] if m.data.photos and m.data.photos.length else null %}
          <span class="thumb">
            {% if cover %}
            <img src="{{ ('/assets/machines/' ~ m.fileSlug ~ '/' ~ (cover.poster if cover.video else cover.file)) | url }}" alt="" loading="lazy">
            {% elif m.data.still %}
            <img src="{{ ('/assets/machines/' ~ m.fileSlug ~ '/' ~ m.data.still) | url }}" alt="" loading="lazy">
            {% else %}
            {{ icon(m.data.glyph or "compact", 64) }}
            {% endif %}
          </span>
          <span class="name">{{ m.data.title }}</span>
          <span class="sub">{{ m.data.year }}{% if m.data.sample %}, sample{% endif %}</span>
        </a>
      </li>
      {% endfor %}
    </ul>
    </div>
  </section>

  {# Video montages of the PowerBooks, in the same scrolling strip as the machine pages #}
  {% set montages = [
    { video: "powerbook-montage-1.mp4", poster: "powerbook-montage-1-poster.jpg", alt: "Video montage 1 of the PowerBooks in the collection" },
    { video: "powerbook-montage-2.mp4", poster: "powerbook-montage-2-poster.jpg", alt: "Video montage 2 of the PowerBooks in the collection" }
  ] %}
  <section class="window cascade movies" aria-labelledby="montage-title">
    <div class="titlebar">
      <span class="closebox" aria-hidden="true"></span>
      <h2 id="montage-title">PowerBook Montages</h2>
      <span class="zoombox" aria-hidden="true"></span>
    </div>
    <div class="winbody">
    <div class="strip strip-multi" data-strip data-noun="video">
      <div class="infobar">
        <span data-strip-status>{{ montages.length }} videos</span>
        <span>Swipe or use the scroll bar</span>
      </div>
      <div class="slides" data-strip-slides tabindex="0" role="group" aria-label="Video montages of the PowerBooks">
        {% for v in montages %}
        <figure class="slide slide-video">
          <video controls playsinline preload="metadata" poster="{{ ('/assets/montages/' ~ v.poster) | url }}" aria-label="{{ v.alt }}">
            <source src="{{ ('/assets/montages/' ~ v.video) | url }}" type="video/mp4">
            Your browser can't play this video.
          </video>
        </figure>
        {% endfor %}
      </div>
      <div class="sbar" data-strip-bar hidden>
        <button type="button" class="sbtn" data-dir="-1" aria-label="Previous video">
          <svg viewBox="0 0 16 16" width="16" height="16" shape-rendering="crispEdges" aria-hidden="true" focusable="false"><polygon points="10,3 10,13 4,8" fill="currentColor"/></svg>
        </button>
        <div class="track" data-strip-track><span class="knob" data-strip-knob></span></div>
        <button type="button" class="sbtn" data-dir="1" aria-label="Next video">
          <svg viewBox="0 0 16 16" width="16" height="16" shape-rendering="crispEdges" aria-hidden="true" focusable="false"><polygon points="6,3 6,13 12,8" fill="currentColor"/></svg>
        </button>
      </div>
    </div>
    </div>
  </section>

  {% if documented < total %}
  <section class="window cascade checklist" data-front aria-labelledby="checklist-title">
    <div class="titlebar">
      <span class="closebox" aria-hidden="true"></span>
      <h2 id="checklist-title">Checklist</h2>
      <span class="zoombox" aria-hidden="true"></span>
    </div>
    <div class="winbody">
    <div class="infobar">
      <span>{{ documented }} of {{ total }} documented</span>
      <span>Checked once a machine has a photo</span>
    </div>
    <ul class="checks" role="list">
      {% for m in collections.machines %}
      {% set done = m.data.photos and m.data.photos.length %}
      <li>
        <a class="check-row" href="{{ m.url | url }}">
          <span class="check{% if done %} is-done{% endif %}" aria-hidden="true"></span>
          <span>{{ m.data.title }}</span>
          <span class="visually-hidden">{% if done %}, documented{% else %}, not yet documented{% endif %}</span>
        </a>
      </li>
      {% endfor %}
    </ul>
    </div>
  </section>
  {% endif %}

</div>

<script src="{{ '/assets/js/strip.js' | url }}" defer></script>
