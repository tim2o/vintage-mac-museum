{# The Videos window, built from src/_data/montages.json. On a desktop browser it is spawned from the Videos menu (see windows.js), so a template copy is used; on a phone it is the page at /videos/. #}
{% set hl = "h1" if static else "h2" %}
<section class="window movies" id="videos" aria-labelledby="montage-title">
  <div class="titlebar">
    {% if static %}<span class="closebox" aria-hidden="true"></span>{% else %}<button type="button" class="closebox" aria-label="Close Videos"></button>{% endif %}
    <{{ hl }} id="montage-title">Videos</{{ hl }}>
    <span class="zoombox" aria-hidden="true"></span>
  </div>
  <div class="winbody">
  <div class="strip strip-multi" data-strip data-noun="video">
    <div class="infobar">
      <span data-strip-status>{{ montages | length }} {% if montages | length == 1 %}video{% else %}videos{% endif %}</span>
      <span>Swipe or use the scroll bar</span>
    </div>
    <div class="slides" data-strip-slides tabindex="0" role="group" aria-label="Videos of the collection">
      {% for v in montages %}
      {% set mediaDir = v.dir or "/assets/montages/" %}
      <figure class="slide slide-video">
        <video controls playsinline preload="metadata" poster="{{ (mediaDir ~ v.poster) | url }}" aria-label="{{ v.alt }}" style="aspect-ratio: {{ v.width }} / {{ v.height }}">
          <source src="{{ (mediaDir ~ v.video) | url }}" type="video/mp4">
          Your browser can't play this video.
        </video>
      </figure>
      {% endfor %}
    </div>
    <div class="sbar" data-strip-bar hidden>
      <button type="button" class="sbtn" data-dir="-1" aria-label="Previous video">
        <svg viewBox="0 0 16 16" width="16" height="16" shape-rendering="crispEdges" aria-hidden="true" focusable="false"><polygon points="10,3 10,13 4,8" fill="currentColor"/></svg>
      </button>
      <div class="track" data-strip-track><span class="knob" data-strip-knob></span></div>
      <button type="button" class="sbtn" data-dir="1" aria-label="Next video">
        <svg viewBox="0 0 16 16" width="16" height="16" shape-rendering="crispEdges" aria-hidden="true" focusable="false"><polygon points="6,3 6,13 12,8" fill="currentColor"/></svg>
      </button>
    </div>
  </div>
  </div>
</section>
