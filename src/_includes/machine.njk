---
layout: base.njk
---
{% from "icons.njk" import icon %}
{% set mediaDir = '/assets/machines/' ~ page.fileSlug ~ '/' %}
{% set prev = collections.machines | getPreviousCollectionItem(page) %}
{% set next = collections.machines | getNextCollectionItem(page) %}
{% set iconKind = glyph or "compact" %}

<div class="machine-layout">

  {# Main window: the photos and the write-up, like a SimpleText document #}
  <article class="window">
    <div class="titlebar">
      <a class="closebox" href="{{ '/' | url }}" aria-label="Close this window and return to the collection"></a>
      <h1>{{ title }}</h1>
      <span class="zoombox" aria-hidden="true"></span>
    </div>
    <div class="doc">
      {% if sample %}
      <p class="alert">
        {{ icon("caution", 32) }}
        <span><strong>Sample entry.</strong> This page shows how a machine is laid out. Replace its details and photos with your own, or delete the file.</span>
      </p>
      {% endif %}

      {% if photos and photos.length %}
      {# Side-scrolling photo strip with a System 7-style scroll bar (see assets/js/strip.js) #}
      {% set multi = photos.length > 1 %}
      {% set hasVideo = (photos | selectattr("video") | list).length > 0 %}
      {% set noun = "item" if hasVideo else "photo" %}
      <div class="strip{% if multi %} strip-multi{% endif %}" data-strip data-noun="{{ noun }}">
        <div class="infobar">
          <span data-strip-status>{{ photos.length }} {{ noun }}{% if multi %}s{% endif %}</span>
          {% if multi %}<span>Swipe or use the scroll bar</span>{% endif %}
        </div>
        <div class="slides" data-strip-slides{% if multi %} tabindex="0" role="group" aria-label="Photos of {{ title }}"{% endif %}>
          {% for p in photos %}
          {% if p.video %}
          <figure class="slide slide-video">
            <video controls playsinline preload="metadata"{% if p.poster %} poster="{{ (mediaDir ~ p.poster) | url }}"{% endif %} aria-label="{{ p.alt or title }}">
              <source src="{{ (mediaDir ~ p.video) | url }}" type="video/mp4">
              Your browser can't play this video.
            </video>
          </figure>
          {% else %}
          <figure class="slide">
            <a href="{{ (mediaDir ~ p.file) | url }}">
              <img src="{{ (mediaDir ~ p.file) | url }}" alt="{{ p.alt or title }}" decoding="async" draggable="false">
            </a>
          </figure>
          {% endif %}
          {% endfor %}
        </div>
        {% if multi %}
        <div class="sbar" data-strip-bar hidden>
          <button type="button" class="sbtn" data-dir="-1" aria-label="Previous photo">
            <svg viewBox="0 0 16 16" width="16" height="16" shape-rendering="crispEdges" aria-hidden="true" focusable="false"><polygon points="10,3 10,13 4,8" fill="currentColor"/></svg>
          </button>
          <div class="track" data-strip-track><span class="knob" data-strip-knob></span></div>
          <button type="button" class="sbtn" data-dir="1" aria-label="Next photo">
            <svg viewBox="0 0 16 16" width="16" height="16" shape-rendering="crispEdges" aria-hidden="true" focusable="false"><polygon points="6,3 6,13 12,8" fill="currentColor"/></svg>
          </button>
        </div>
        {% endif %}
      </div>
      {% else %}
      <div class="hero">
        <div class="thumb thumb-empty" role="img" aria-label="No photo yet for {{ title }}">
          {{ icon(iconKind, 64) }}
          <span>No photo yet</span>
        </div>
      </div>
      {% endif %}

      <div class="prose">
        {{ content | safe }}
      </div>

      <div class="buttons">
        {% if prev %}<a class="btn" href="{{ prev.url | url }}" rel="prev">Previous</a>{% endif %}
        <a class="btn btn-default" href="{{ '/' | url }}">All machines</a>
        {% if next %}<a class="btn" href="{{ next.url | url }}" rel="next">Next</a>{% endif %}
      </div>
    </div>
  </article>

  {# Get Info window: the specs #}
  <aside class="window info" aria-label="Specifications for {{ title }}">
    <div class="titlebar">
      <span class="closebox" aria-hidden="true"></span>
      <h2>{{ title }} Info</h2>
      <span class="zoombox" aria-hidden="true"></span>
    </div>
    <div class="info-head">
      {{ icon(iconKind, 32) }}
      <span class="name-big">{{ title }}</span>
    </div>
    <dl class="specs">
      {% if family %}<div><dt>Kind</dt><dd>{{ family }}</dd></div>{% endif %}
      <div><dt>Introduced</dt><dd>{{ year }}</dd></div>
      {% if model %}<div><dt>Model number</dt><dd>{{ model }}</dd></div>{% endif %}
      {% for key, value in specs %}
      <div><dt>{{ key }}</dt><dd>{{ value }}</dd></div>
      {% endfor %}
    </dl>
    {% if status %}
    <div class="comments">
      <span class="label">Condition</span>
      <div class="box">{{ status }}</div>
    </div>
    {% endif %}
  </aside>

  {# One QuickTime-style window per video #}
  {% if videos and videos.length %}
  {% for v in videos %}
  <section class="window span">
    <div class="titlebar">
      <span class="closebox" aria-hidden="true"></span>
      <h2>{{ v.title }}</h2>
      <span class="zoombox" aria-hidden="true"></span>
    </div>
    <div class="movie">
      {% if v.youtube %}
      <iframe src="https://www.youtube-nocookie.com/embed/{{ v.youtube }}" title="{{ v.title }}" loading="lazy" allowfullscreen></iframe>
      {% else %}
      <video controls preload="metadata"{% if v.poster %} poster="{{ (mediaDir ~ v.poster) | url }}"{% endif %}>
        <source src="{{ (mediaDir ~ v.file) | url }}" type="video/mp4">
        Your browser can't play this video.
      </video>
      {% endif %}
    </div>
    {% if v.description %}<p class="movie-caption">{{ v.description }}</p>{% endif %}
  </section>
  {% endfor %}
  {% endif %}

</div>

<script src="{{ '/assets/js/strip.js' | url }}" defer></script>
