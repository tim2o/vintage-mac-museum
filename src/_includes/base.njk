<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ summary or description or site.description }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=Sacramento&display=swap" rel="stylesheet">
  <script>document.documentElement.classList.add("js");try{var d=localStorage.getItem("cs-desk"),h=localStorage.getItem("cs-hilite"),t=localStorage.getItem("cs-theme");if(d)document.documentElement.setAttribute("data-desk",d);if(h)document.documentElement.setAttribute("data-hilite",h);if(t)document.documentElement.setAttribute("data-theme",t)}catch(e){}</script>
  <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}?v={{ build }}">
</head>
<body data-home="{{ '/' | url }}">
  <a class="skip" href="#main">Skip to content</a>

  <header class="menubar">
    <nav class="menus" aria-label="Main">
      <div class="menu menu-apple">
        <button type="button" class="menu-logo" aria-haspopup="menu" aria-expanded="false" aria-label="Apple menu"><img class="menu-mac" src="{{ '/assets/img/icons/menu-apple-flat.png' | url }}" width="16" height="16" alt=""></button>
        <ul class="dropdown" role="list">
          <li><a href="{{ '/about/' | url }}" data-open-window="about">About This Collection</a></li>
          <li><a href="{{ '/note/' | url }}" data-open-window="note">Leave Me a Note&hellip;</a></li>
        </ul>
      </div>
      <div class="menu">
        {# On a desktop browser the title only shows the menu; All machines opens the Collection window (see windows.js) #}
        <a href="{{ '/' | url }}" data-menu-title>Collection</a>
        <ul class="dropdown" role="list">
          <li><a href="{{ '/' | url }}" data-open-window="collection">All machines</a></li>
          <li class="sep" aria-hidden="true"></li>
          {% for m in collections.machines %}
          <li><a href="{{ m.url | url }}">{{ m.data.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div class="menu">
        {# On a desktop browser the title only shows the menu (see windows.js); on a phone it goes to all the videos. #}
        <a href="{{ '/videos/' | url }}" data-menu-title>Videos</a>
        <ul class="dropdown" role="list">
          <li><a href="{{ '/videos/' | url }}" data-open-window="videos">All videos</a></li>
          <li class="sep" aria-hidden="true"></li>
          {% for v in montages %}
          <li><a href="{{ ('/videos/' ~ v.page ~ '/') | url }}" data-open-window="movie" data-video="{{ loop.index0 }}">{{ v.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div class="menu">
        <a href="{{ '/checklist/' | url }}" data-open-window="checklist">Checklist</a>
      </div>
    </nav>
    <div class="menubar-right">
      <button type="button" class="clock" id="clock" title="Click to show today's date"></button>
      {# The Application menu: Finder, then the same places as the desktop icons #}
      <div class="app-menu">
        <button type="button" class="app-menu-button" aria-haspopup="menu" aria-expanded="false" aria-controls="app-list">
          <img class="app-icon" src="{{ '/assets/img/icons/menu-finder.png' | url }}" width="16" height="16" alt="">Finder
        </button>
        <ul class="app-list" id="app-list" role="menu" hidden>
          <li class="is-front" role="none"><button type="button" role="menuitem"><img src="{{ '/assets/img/icons/menu-finder.png' | url }}" width="16" height="16" alt="">Finder</button></li>
          <li class="sep" role="separator"></li>
          <li role="none"><a role="menuitem" href="{{ '/' | url }}" data-open-window="collection"><img src="{{ '/assets/img/icons/disk-16.png' | url }}" width="16" height="16" alt="">{{ site.title }}</a></li>
          <li role="none"><a role="menuitem" href="{{ '/about/' | url }}" data-open-window="about"><img src="{{ '/assets/img/icons/doc-16.png' | url }}" width="16" height="16" alt="">About This Collection</a></li>
          <li role="none"><a role="menuitem" href="{{ '/checklist/' | url }}" data-open-window="checklist"><img src="{{ '/assets/img/icons/checklist-16.png' | url }}" width="16" height="16" alt="">Checklist</a></li>
          <li role="none"><button type="button" role="menuitem" data-popup="intel" data-popup-title="Intel Macs" data-popup-icon="{{ '/assets/img/icons/laptop.png' | url }}"><img src="{{ '/assets/img/icons/laptop-16.png' | url }}" width="16" height="16" alt="">Intel Macs</button></li>
          <li role="none"><button type="button" role="menuitem" data-popup="m-series" data-popup-title="Modern M-Series Macs" data-popup-icon="{{ '/assets/img/icons/mini.png' | url }}"><img src="{{ '/assets/img/icons/mini-16.png' | url }}" width="16" height="16" alt="">Modern M-Series Macs</button></li>
        </ul>
      </div>
    </div>
  </header>

  {# Desktop icons down the right-hand side, one for each page of the site #}
  {% from "icons.njk" import icon %}
  <nav class="desk-icons" aria-label="Desktop">
    <a class="desk-icon" data-icon-id="shelf" href="{{ '/' | url }}" data-open-window="collection">
      {{ icon("disk", 64) }}
      <span>{{ site.title }}</span>
    </a>
    <a class="desk-icon" data-icon-id="about" href="{{ '/about/' | url }}" data-open-window="about">
      {{ icon("doc", 64) }}
      <span>About This Collection</span>
    </a>
    <a class="desk-icon" data-icon-id="checklist" href="{{ '/checklist/' | url }}" data-open-window="checklist">
      {{ icon("checklist", 64) }}
      <span>Checklist</span>
    </a>
    {# Placeholders: each opens a "coming soon" window (see windows.js) #}
    <button type="button" class="desk-icon" data-icon-id="intel" data-popup="intel" data-popup-title="Intel Macs" data-popup-icon="{{ '/assets/img/icons/laptop.png' | url }}" aria-haspopup="dialog">
      {{ icon("laptop", 64) }}
      <span>Intel Macs</span>
    </button>
    <button type="button" class="desk-icon" data-icon-id="mseries" data-popup="m-series" data-popup-title="Modern M-Series Macs" data-popup-icon="{{ '/assets/img/icons/mini.png' | url }}" aria-haspopup="dialog">
      {{ icon("mini", 64) }}
      <span>Modern M-Series Macs</span>
    </button>
    {# The Trash, lower right as on the Mac OS desktop. For now it only says it is empty (see windows.js). #}
    <button type="button" class="desk-icon desk-trash" data-icon-id="trash" data-popup="trash" data-popup-title="Trash" data-popup-heading="The Trash is empty." data-popup-text="" data-popup-icon="{{ '/assets/img/icons/trash.png' | url }}" aria-haspopup="dialog">
      {{ icon("trash", 64) }}
      <span>Trash</span>
    </button>
  </nav>

  <main id="main">
    {{ content | safe }}
  </main>

  {# The pages of the machines, for the Control Strip's random-machine module (see controlstrip.js) #}
  <script type="application/json" id="machine-urls">[{% for m in collections.machines %}"{{ m.url | url }}"{% if not loop.last %},{% endif %}{% endfor %}]</script>
  <script src="{{ '/assets/js/windows.js' | url }}?v={{ build }}" defer></script>
  <script src="{{ '/assets/js/controlstrip.js' | url }}?v={{ build }}" defer></script>
  <script src="{{ '/assets/js/desk-icons.js' | url }}?v={{ build }}" defer></script>

  <script>
    (function () {
      var el = document.getElementById("clock");
      if (!el) return;
      var showingDate = false;
      var timer = null;
      function tick() {
        if (showingDate) return;
        var now = new Date();
        // The Mac OS 8 clock shows the day of the week and the time, like "Sat 5:08 PM".
        el.textContent =
          now.toLocaleDateString([], { weekday: "short" }) + " " +
          now.toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });
      }
      // Click the time to see the whole date for a few seconds, as on the Mac OS clock, then it goes back.
      el.addEventListener("click", function () {
        window.clearTimeout(timer);
        var narrow = window.matchMedia("(max-width: 40rem)").matches;
        showingDate = true;
        el.textContent = new Date().toLocaleDateString([], {
          weekday: narrow ? "short" : "long",
          month: narrow ? "short" : "long",
          day: "numeric",
          year: "numeric"
        });
        timer = window.setTimeout(function () {
          showingDate = false;
          tick();
        }, 4000);
      });
      tick();
      setInterval(tick, 15000);
    })();
  </script>

  {# Visitor counter: GoatCounter, no cookies. Stats: https://tims-mac-shelf.goatcounter.com #}
  <script data-goatcounter="https://tims-mac-shelf.goatcounter.com/count"
          async src="//gc.zgo.at/count.js"></script>
</body>
</html>
