{#
  Small pixel-art icons, drawn for this site. Each is a generic computer shape,
  not a copy of any Apple icon. Use: {% from "icons.njk" import icon %}{{ icon("compact", 48) }}
  Kinds: compact, desktop, imac, disk, caution.
#}
{% macro icon(kind, size) %}
<svg class="icon icon-{{ kind }}" viewBox="0 0 32 32" width="{{ size or 32 }}" height="{{ size or 32 }}" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
  {% if kind == "desktop" %}
  <rect x="3.5" y="2.5" width="25" height="17" fill="#fff" stroke="#000"/>
  <rect x="6.5" y="5.5" width="19" height="11" fill="#ccc" stroke="#000"/>
  <rect x="13" y="20" width="6" height="2" fill="#000"/>
  <rect x="6.5" y="22.5" width="19" height="6" fill="#fff" stroke="#000"/>
  <rect x="9" y="25" width="8" height="1" fill="#000"/>
  {% elif kind == "imac" %}
  <rect x="5.5" y="3.5" width="21" height="20" rx="5" fill="#fff" stroke="#000"/>
  <rect x="8.5" y="6.5" width="15" height="12" fill="#ccc" stroke="#000"/>
  <rect x="10.5" y="25.5" width="11" height="3" fill="#fff" stroke="#000"/>
  {% elif kind == "disk" %}
  <rect x="3.5" y="9.5" width="25" height="14" rx="2" fill="#fff" stroke="#000"/>
  <rect x="6" y="13" width="20" height="1" fill="#000"/>
  <rect x="6" y="19" width="12" height="1" fill="#000"/>
  <rect x="22" y="17" width="4" height="4" fill="#000"/>
  {% elif kind == "caution" %}
  <polygon points="16,3.5 29.5,28.5 2.5,28.5" fill="#fff" stroke="#000"/>
  <rect x="15" y="11" width="2" height="9" fill="#000"/>
  <rect x="15" y="22" width="2" height="2" fill="#000"/>
  {% else %}
  <rect x="6.5" y="2.5" width="19" height="25" fill="#fff" stroke="#000"/>
  <rect x="9.5" y="5.5" width="13" height="10" fill="#ccc" stroke="#000"/>
  <rect x="11" y="21" width="10" height="1" fill="#000"/>
  <rect x="4.5" y="27.5" width="23" height="2" fill="#fff" stroke="#000"/>
  {% endif %}
</svg>
{% endmacro %}
