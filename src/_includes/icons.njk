{#
  Pixel-art icons in the style of the Mac OS 8 Platinum desktop: a dark outline, a light edge on the
  top and left, a shaded edge on the bottom and right, and a little colour. They are drawn for this
  site as generic computer shapes and are not copies of any Apple icon.
  Use: {% from "icons.njk" import icon %}{{ icon("compact", 64) }}
  Kinds: compact, desktop, imac, laptop, cube, flatpanel, tower, disk, doc, caution.
  Draw them at 32 or 64 pixels so every drawn pixel lands on a whole screen pixel.
#}

{# A bevelled slab: outline, fill, light top and left edge, shaded bottom and right edge #}
{% macro bev(x, y, w, h, fill, hi, lo) %}
<rect x="{{ x }}" y="{{ y }}" width="{{ w }}" height="{{ h }}" fill="#1c1c1c"/>
<rect x="{{ x + 1 }}" y="{{ y + 1 }}" width="{{ w - 2 }}" height="{{ h - 2 }}" fill="{{ fill or '#d2d2d2' }}"/>
<rect x="{{ x + 1 }}" y="{{ y + 1 }}" width="{{ w - 2 }}" height="1" fill="{{ hi or '#fff' }}"/>
<rect x="{{ x + 1 }}" y="{{ y + 1 }}" width="1" height="{{ h - 2 }}" fill="{{ hi or '#fff' }}"/>
<rect x="{{ x + 1 }}" y="{{ y + h - 2 }}" width="{{ w - 2 }}" height="1" fill="{{ lo or '#8c8c8c' }}"/>
<rect x="{{ x + w - 2 }}" y="{{ y + 1 }}" width="1" height="{{ h - 2 }}" fill="{{ lo or '#8c8c8c' }}"/>
{% endmacro %}

{# A glass screen: dark rim, blue glass in three bands, and a bright glint #}
{% macro glass(x, y, w, h) %}
<rect x="{{ x }}" y="{{ y }}" width="{{ w }}" height="{{ h }}" fill="#1c1c1c"/>
<rect x="{{ x + 1 }}" y="{{ y + 1 }}" width="{{ w - 2 }}" height="{{ h - 2 }}" fill="#5f86bb"/>
<rect x="{{ x + 1 }}" y="{{ y + 1 }}" width="{{ w - 2 }}" height="{{ ((h - 2) / 3) | round }}" fill="#7ea3d3"/>
<rect x="{{ x + 1 }}" y="{{ y + h - 1 - (((h - 2) / 4) | round) }}" width="{{ w - 2 }}" height="{{ ((h - 2) / 4) | round }}" fill="#486da3"/>
<rect x="{{ x + 2 }}" y="{{ y + 2 }}" width="{{ ((w - 4) / 3) | round }}" height="1" fill="#d6e6f7"/>
<rect x="{{ x + 2 }}" y="{{ y + 3 }}" width="1" height="1" fill="#d6e6f7"/>
{% endmacro %}

{% macro icon(kind, size) %}
<svg class="icon icon-{{ kind }}" viewBox="0 0 32 32" width="{{ size or 32 }}" height="{{ size or 32 }}" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
  {% if kind == "desktop" %}
  <g fill="#000" fill-opacity=".25"><rect x="7" y="4" width="22" height="15"/><rect x="6" y="21" width="24" height="9"/></g>
  {{ bev(5, 2, 22, 15) }}
  {{ glass(8, 5, 16, 9) }}
  {{ bev(12, 17, 8, 2, '#a8a8a8') }}
  {{ bev(4, 19, 24, 9) }}
  <rect x="7" y="23" width="9" height="1" fill="#1c1c1c"/><rect x="7" y="24" width="9" height="1" fill="#fff"/>
  <rect x="22" y="22" width="3" height="3" fill="#1c1c1c"/><rect x="23" y="23" width="1" height="1" fill="#62c262"/>
  {% elif kind == "imac" %}
  <g fill="#000" fill-opacity=".25"><rect x="7" y="4" width="22" height="22" rx="5"/><rect x="12" y="27" width="12" height="4"/></g>
  <rect x="5" y="2" width="22" height="22" rx="5" fill="#1c1c1c"/>
  <rect x="6" y="3" width="20" height="20" rx="4" fill="#7fc7d1"/>
  <rect x="7" y="19" width="18" height="3" fill="#5aa7b4"/>
  <rect x="8" y="3" width="14" height="1" fill="#d5f1f4"/><rect x="6" y="6" width="1" height="8" fill="#d5f1f4"/>
  {{ glass(8, 5, 16, 12) }}
  <rect x="14" y="20" width="4" height="1" fill="#1c1c1c"/>
  {{ bev(10, 25, 12, 3, '#7fc7d1', '#d5f1f4', '#4f9aa7') }}
  {% elif kind == "laptop" %}
  <g fill="#000" fill-opacity=".25"><rect x="9" y="5" width="18" height="14"/><polygon points="5,20 31,20 32,28 3,28"/></g>
  {{ bev(7, 3, 18, 14) }}
  {{ glass(10, 6, 12, 8) }}
  <polygon points="3,18 29,18 31,26 1,26" fill="#1c1c1c"/>
  <polygon points="4,19 28,19 29,25 3,25" fill="#d2d2d2"/>
  <rect x="4" y="19" width="24" height="1" fill="#fff"/>
  <rect x="8" y="20" width="16" height="3" fill="#4f4f4f"/>
  <rect x="8" y="20" width="16" height="1" fill="#8c8c8c"/><rect x="8" y="22" width="16" height="1" fill="#8c8c8c"/>
  <rect x="13" y="24" width="6" height="1" fill="#8c8c8c"/>
  {% elif kind == "cube" %}
  <g fill="#000" fill-opacity=".25"><rect x="8" y="5" width="20" height="20"/><rect x="11" y="27" width="16" height="4"/></g>
  {{ bev(6, 3, 20, 21, '#e6eef6', '#fff', '#9db0c4') }}
  <rect x="10" y="7" width="12" height="13" fill="#1c1c1c"/>
  <rect x="11" y="8" width="10" height="11" fill="#46566c"/>
  <rect x="11" y="8" width="10" height="3" fill="#6f84a3"/>
  <rect x="11" y="8" width="1" height="11" fill="#8da2c1"/>
  {{ bev(8, 25, 16, 3, '#b8b8b8') }}
  {% elif kind == "flatpanel" %}
  <g fill="#000" fill-opacity=".25"><rect x="5" y="6" width="26" height="17"/><rect x="11" y="27" width="16" height="4"/></g>
  {{ bev(3, 4, 26, 17, '#e4e4e4') }}
  {{ glass(6, 7, 20, 11) }}
  {{ bev(14, 21, 4, 5, '#a8a8a8') }}
  {{ bev(9, 25, 14, 3, '#bdbdbd') }}
  {% elif kind == "tower" %}
  <g fill="#000" fill-opacity=".25"><rect x="11" y="4" width="14" height="27"/></g>
  {{ bev(9, 2, 14, 27) }}
  {{ bev(11, 5, 10, 4, '#bcbcbc') }}
  <rect x="12" y="7" width="8" height="1" fill="#1c1c1c"/>
  {{ bev(11, 11, 10, 3, '#bcbcbc') }}
  <rect x="13" y="12" width="6" height="1" fill="#1c1c1c"/>
  <rect x="12" y="16" width="8" height="1" fill="#8c8c8c"/><rect x="12" y="18" width="8" height="1" fill="#8c8c8c"/><rect x="12" y="20" width="8" height="1" fill="#8c8c8c"/>
  <rect x="19" y="23" width="2" height="2" fill="#1c1c1c"/><rect x="19" y="23" width="1" height="1" fill="#62c262"/>
  {{ bev(12, 23, 5, 4, '#a9b6d0') }}
  {% elif kind == "disk" %}
  <g fill="#000" fill-opacity=".25"><rect x="4" y="12" width="28" height="15"/></g>
  {{ bev(2, 10, 28, 15) }}
  <rect x="5" y="14" width="22" height="1" fill="#8c8c8c"/><rect x="5" y="15" width="22" height="1" fill="#fff"/>
  <rect x="5" y="19" width="14" height="4" fill="#1c1c1c"/>
  <rect x="6" y="20" width="12" height="2" fill="#f4f4f4"/>
  <rect x="7" y="21" width="7" height="1" fill="#6b82a8"/>
  <rect x="22" y="19" width="5" height="4" fill="#1c1c1c"/>
  <rect x="23" y="20" width="3" height="2" fill="#62c262"/>
  <rect x="4" y="25" width="4" height="1" fill="#1c1c1c"/><rect x="24" y="25" width="4" height="1" fill="#1c1c1c"/>
  {% elif kind == "doc" %}
  <g fill="#000" fill-opacity=".25"><polygon points="9,4 23,4 29,10 29,32 9,32"/></g>
  <polygon points="7,2 21,2 27,8 27,30 7,30" fill="#1c1c1c"/>
  <polygon points="8,3 20,3 26,9 26,29 8,29" fill="#fff"/>
  <rect x="25" y="9" width="1" height="20" fill="#b4b4b4"/><rect x="8" y="28" width="18" height="1" fill="#b4b4b4"/>
  <polygon points="20,3 20,9 26,9" fill="#d6d6d6"/>
  <rect x="20" y="3" width="1" height="7" fill="#1c1c1c"/><rect x="20" y="9" width="7" height="1" fill="#1c1c1c"/>
  <rect x="11" y="11" width="7" height="2" fill="#6f95c9"/>
  <rect x="11" y="15" width="12" height="1" fill="#6a7690"/><rect x="11" y="18" width="12" height="1" fill="#6a7690"/>
  <rect x="11" y="21" width="12" height="1" fill="#6a7690"/><rect x="11" y="24" width="8" height="1" fill="#6a7690"/>
  {% elif kind == "caution" %}
  <g fill="#000" fill-opacity=".25"><polygon points="18,4 32,31 4,31"/></g>
  <polygon points="16,2 30,29 2,29" fill="#1c1c1c"/>
  <polygon points="16,5 27,27 5,27" fill="#ffd84a"/>
  <polygon points="16,5 27,27 16,27" fill="#efb82a"/>
  <rect x="15" y="11" width="2" height="9" fill="#1c1c1c"/><rect x="15" y="22" width="2" height="2" fill="#1c1c1c"/>
  {% else %}
  <g fill="#000" fill-opacity=".25"><rect x="9" y="4" width="18" height="24"/><rect x="7" y="29" width="22" height="3"/></g>
  {{ bev(7, 2, 18, 25) }}
  {{ glass(10, 5, 12, 11) }}
  <rect x="11" y="20" width="7" height="1" fill="#1c1c1c"/><rect x="11" y="21" width="7" height="1" fill="#fff"/>
  <rect x="21" y="20" width="2" height="2" fill="#8c8c8c"/>
  {{ bev(5, 27, 22, 3, '#b4b4b4') }}
  {% endif %}
</svg>
{% endmacro %}
