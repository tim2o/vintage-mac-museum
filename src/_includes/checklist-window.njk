{# The Checklist window. On a desktop browser it is spawned from the Checklist menu, the desktop icon or the Application menu (see windows.js), so a template copy is used; on a phone it is the page at /checklist/. #}
{% set hl = "h1" if static else "h2" %}
<section class="window checklist" id="checklist" aria-labelledby="checklist-title">
  <div class="titlebar">
    {% if static %}<span class="closebox" aria-hidden="true"></span>{% else %}<button type="button" class="closebox" aria-label="Close Checklist"></button>{% endif %}
    <{{ hl }} id="checklist-title">Checklist</{{ hl }}>
    <span class="zoombox" aria-hidden="true"></span>
  </div>
  <div class="winbody">
  <div class="infobar">
    <span>{{ documented }} of {{ total }} documented</span>
    <span>Checked once a machine has a photo</span>
  </div>
  <ul class="checks" role="list">
    {% for m in collections.machines %}
    {% set done = m.data.photos and m.data.photos.length %}
    <li>
      <a class="check-row" href="{{ m.url | url }}">
        <span class="check{% if done %} is-done{% endif %}" aria-hidden="true"></span>
        <span>{{ m.data.title }}</span>
        <span class="visually-hidden">{% if done %}, documented{% else %}, not yet documented{% endif %}</span>
      </a>
    </li>
    {% endfor %}
  </ul>
  </div>
</section>
